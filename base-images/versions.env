# Pins for local/ai-* bases used by logging-stack services on CI.

UBUNTU_VERSION=22.04
UBUNTU_SOURCE_IMAGE="${UBUNTU_SOURCE_IMAGE:-m.daocloud.io/docker.io/library/ubuntu:22.04}"
UBUNTU_APT_MIRROR="${UBUNTU_APT_MIRROR:-repo.huaweicloud.com}"
UBUNTU_BUILD_IMAGE=local/ai-ubuntu-build:${UBUNTU_VERSION}-v1
UBUNTU_RUNTIME_IMAGE=local/ai-ubuntu-runtime:${UBUNTU_VERSION}-apt-v1

# Official Temurin linux-x64 binary. Do not compile OpenJDK from source.
JDK_VERSION=21.0.12
JDK_BUILD=8
JDK_TAG=jdk-21.0.12+8
JDK_BUILD_IMAGE=local/ai-jdk-build:${JDK_VERSION}-v1
JDK_RUNTIME_IMAGE=local/ai-jdk-runtime:${JDK_VERSION}-apt-v1

GO_VERSION=1.26.5
GO_BOOTSTRAP_VERSION=1.25.9
GO_TOOLCHAIN_IMAGE=local/ai-go-toolchain:${GO_VERSION}

# Official Node linux-x64 binary. Do not compile from source on Ubuntu 22.04/GCC 11.
NODE_VERSION=24.18.0
NODE_BUILD_IMAGE=local/ai-node-build:${NODE_VERSION}-v1
NODE_RUNTIME_IMAGE=local/ai-node-runtime:${NODE_VERSION}-apt-v1
